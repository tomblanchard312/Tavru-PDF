[Desktop Entry]
Type=Application
Name=Tavru PDF
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=parchfold %U
TryExec=parchfold
Icon=io.github.tomblanchard312.Nabu
Terminal=false
StartupNotify=true
StartupWMClass=io.github.tomblanchard312.Nabu
Categories=Office;Viewer;
Keywords=pdf;viewer;editor;annotate;sign;forms;merge;split;
MimeType=application/pdf;
